#include <ESP8266WiFi.h>
#include <Ticker.h>

// --- DECLARAȚII / PROTOTIPURI FUNCȚII ---
void setEnableWifi();

// --- DECLARAȚII ȘI VARIABILE NOI PENTRU SCANARE ---
Ticker wifiCheckTimer;
volatile bool doWifiCheck = false;

const int RSSI_HYSTERESIS = 12; // Diferență de minim 12 dBm pentru comutare
const unsigned long CHECK_INTERVAL_SECONDS = 3600; // 60 de minute

void setEnableWifi()
{
	doEnableWifi = true;
}

void setWifiCheckFlag()
{
	doWifiCheck = true;
}

// --- EVENIMENTE WI-FI ---

void onWifiConnect(const WiFiEventStationModeConnected &event)
{
#ifdef DEBUG
	Serial.println(F("[ INFO ] WiFi STA Connected"));
#endif
	mqttReconnectTimer.detach();
	if (!wifiReconnectTimer.active() && !config.fallbackMode)
	{
		wifiReconnectTimer.once(300, setEnableWifi);
	}
	ledWifiOff();
}

void onWifiDisconnect(const WiFiEventStationModeDisconnected &event)
{
#ifdef DEBUG
	Serial.println(F("[ INFO ] WiFi STA Disconnected"));
#endif
	mqttReconnectTimer.detach();
	wifiCheckTimer.detach();
	disconnectMqtt();
	if (!wifiReconnectTimer.active() && !config.fallbackMode)
	{
		wifiReconnectTimer.once(300, setEnableWifi);
	}
	ledWifiOff();
}

void onWifiGotIP(const WiFiEventStationModeGotIP &event)
{
#ifdef DEBUG
	Serial.print("[ INFO ] WiFi IP Connected: ");
	Serial.println(WiFi.localIP().toString());
#endif
	wifiReconnectTimer.detach();
	ledWifiOn();
	connectToMqtt();

	// Pornim temporizatorul de verificare periodică (60m)
	wifiCheckTimer.attach(CHECK_INTERVAL_SECONDS, setWifiCheckFlag);
}

// --- FUNCȚII ACCESS POINT (AP) ---

bool ICACHE_FLASH_ATTR startAP(IPAddress apip, IPAddress apsubnet, bool hidden, const char *ssid, const char *password = NULL)
{
#ifdef DEBUG
	Serial.println(F("[ INFO ] ESP-RFID is running in AP Mode "));
#endif
	WiFi.mode(WIFI_AP);
#ifdef DEBUG
	Serial.print(F("[ INFO ] Configuring access point... "));
#endif

	WiFi.softAPConfig(apip, apip, apsubnet);

	bool success;
	if (hidden)
	{
		success = WiFi.softAP(ssid, password, 3, true);
	}
	else
	{
		success = WiFi.softAP(ssid, password);
	}
#ifdef DEBUG
	Serial.println(success ? F("Ready") : F("Failed!"));
#endif

	if (success)
	{
		ledWifiOn();
	}

#ifdef DEBUG
	IPAddress myIP = WiFi.softAPIP();

	Serial.print(F("[ INFO ] AP IP address: "));
	Serial.println(myIP);
	Serial.printf("[ INFO ] AP SSID: %s\n", ssid);
#endif
	return success;
}

void ICACHE_FLASH_ATTR fallbacktoAPMode()
{
	config.accessPointMode = true;
#ifdef DEBUG
	Serial.println(F("[ INFO ] ESP-RFID is running in Fallback AP Mode"));
#endif
	WiFi.mode(WIFI_AP);
	uint8_t macAddr[6];
	WiFi.softAPmacAddress(macAddr);
	char ssid[15];
	sprintf(ssid, "ESP-RFID-%02x%02x%02x", macAddr[3], macAddr[4], macAddr[5]);
	if (WiFi.softAP(ssid))
	{
		ledWifiOn();
#ifdef DEBUG
		IPAddress myIP = WiFi.softAPIP();

		Serial.print(F("[ INFO ] AP IP address: "));
		Serial.println(myIP);
		Serial.printf("[ INFO ] AP SSID: %s\n", ssid);
#endif
	}
}

// --- CONECTARE STATION (STA) CU PROTECȚIE BSSID INVALID ---

bool ICACHE_FLASH_ATTR connectSTA(const char *ssid, const char *password, byte bssid[6])
{
	bool useBSSID = false;
	WiFi.mode(WIFI_STA);
	WiFi.setSleepMode(WIFI_NONE_SLEEP);
	WiFi.persistent(false);

	if (!config.dhcpEnabled)
	{
		WiFi.config(config.ipAddress, config.gatewayIp, config.subnetIp, config.dnsIp);
	}

#ifdef DEBUG
	Serial.print(F("[ INFO ] Trying to connect WiFi: "));
	Serial.println(ssid);
#endif

	// Verificăm dacă BSSID-ul primit nu este gol (00:00:00:00:00:00)
	for (int i = 0; i < 6; i++)
	{
		if (bssid[i] != 0)
			useBSSID = true;
	}

	if (useBSSID)
	{
#ifdef DEBUG
		Serial.printf("[ INFO ] Trying saved BSSID: %02X:%02X:%02X:%02X:%02X:%02X\n",
					  bssid[0], bssid[1], bssid[2], bssid[3], bssid[4], bssid[5]);
#endif
		WiFi.begin(ssid, password, 0, bssid);

		// Așteptăm maxim 6 secunde să vedem dacă BSSID-ul salvat funcționează
		unsigned long startBSSIDCheck = millis();
		while (millis() - startBSSIDCheck < 6000)
		{
			ledWifiStatus();
			delay(500);
			if (WiFi.isConnected())
			{
				break;
			}
		}

		// Dacă nu s-a conectat în 6s, considerăm că BSSID-ul este greșit/invalid
		if (!WiFi.isConnected())
		{
#ifdef DEBUG
			Serial.println(F("\n[ WARN ] Saved BSSID failed or unavailable! Clearing BSSID and trying SSID standard..."));
#endif
			// Curățăm BSSID-ul salvat în memorie pentru a evita blocajul
			memset(config.bssid, 0, 6);
			WiFi.disconnect();
			delay(100);
			WiFi.begin(ssid, password); // Încercare standard doar cu SSID + Password
		}
	}
	else
	{
#ifdef DEBUG
		Serial.println(F("[ INFO ] Connecting using SSID standard mode..."));
#endif
		WiFi.begin(ssid, password);
	}

	// Încercare generală de conectare (timeout total 15 secunde)
	unsigned long now = millis();
	uint8_t timeout = 15;

	do
	{
		ledWifiStatus();
		delay(500);
#ifdef DEBUG
		if (!WiFi.isConnected())
			Serial.print(F("."));
#endif
		if (WiFi.isConnected())
			break;
	} while (millis() - now < timeout * 1000);

	if (WiFi.isConnected())
	{
		String data = ssid;
		data += " " + WiFi.localIP().toString();
		writeEvent("INFO", "wifi", "WiFi is connected", data);
		return true;
	}
	else
	{
#ifdef DEBUG
		Serial.println();
		Serial.println(F("[ WARN ] Couldn't connect in time"));
#endif
		if (!config.fallbackMode)
		{
			wifiReconnectTimer.once(300, setEnableWifi);
		}
		return false;
	}
}

// --- VERIFICARE ASINCRONĂ PERIODICĂ ---

void checkWifiSignal()
{
	if (WiFi.status() != WL_CONNECTED || config.accessPointMode)
	{
		return;
	}

	WiFi.scanNetworksAsync([](int n) {
		if (n <= 0 || WiFi.status() != WL_CONNECTED) {
			WiFi.scanDelete();
			return;
		}

		int currentRSSI = WiFi.RSSI();
		int bestRSSI = currentRSSI;
		int bestIndex = -1;

		for (int i = 0; i < n; ++i) {
			if (WiFi.SSID(i) == String(config.ssid)) {
				if (WiFi.RSSI(i) > (currentRSSI + RSSI_HYSTERESIS)) {
					if (WiFi.RSSI(i) > bestRSSI) {
						bestRSSI = WiFi.RSSI(i);
						bestIndex = i;
					}
				}
			}
		}

		if (bestIndex != -1) {
			uint8_t *newBSSID = WiFi.BSSID(bestIndex);

			// Actualizăm și BSSID-ul din memorie cu cel nou și valid
			memcpy(config.bssid, newBSSID, 6);

#ifdef DEBUG
			Serial.printf("[ INFO ] Switching to stronger AP (%s) at %d dBm (vs %d dBm)\n",
						  WiFi.BSSIDstr(bestIndex).c_str(), bestRSSI, currentRSSI);
#endif
			WiFi.disconnect();
			WiFi.begin(config.ssid, config.wifiPassword, 0, newBSSID);
		}
#ifdef DEBUG
		else {
			Serial.println(F("[ INFO ] Periodic check complete: Current AP is optimal."));
		}
#endif
		WiFi.scanDelete();
	}, true);
}

// --- ACTIVARE / DEZACTIVARE WI-FI ---

void ICACHE_FLASH_ATTR disableWifi()
{
	wiFiUptimeMillis = 0;
	wifiCheckTimer.detach();
	WiFi.disconnect(true);
	WiFi.softAPdisconnect(true);
#ifdef DEBUG
	Serial.println(F("Turn wifi off."));
#endif
}

void ICACHE_FLASH_ATTR enableWifi()
{
	wiFiUptimeMillis = 0;
	if (config.accessPointMode)
	{
		startAP(config.accessPointIp, config.accessPointSubnetIp, config.networkHidden, config.ssid, config.wifiPassword);
	}
	else
	{
		bool connected = connectSTA(config.ssid, config.wifiPassword, config.bssid);
		if (!connected && config.fallbackMode)
		{
			fallbacktoAPMode();
		}
	}
}

void setupWifi(bool configured)
{
	if (!configured)
	{
		WiFi.hostname("esp-rfid");
		fallbacktoAPMode();
	}
	else
	{
		wifiConnectHandler = WiFi.onStationModeConnected(onWifiConnect);
		wifiDisconnectHandler = WiFi.onStationModeDisconnected(onWifiDisconnect);
		wifiOnStationModeGotIPHandler = WiFi.onStationModeGotIP(onWifiGotIP);
		WiFi.hostname(config.deviceHostname);
		enableWifi();
	}
}

// --- APELAT DIN LOOP() PRINCIPAL ---
void handleWifiPeriodicCheck()
{
	if (doWifiCheck)
	{
		doWifiCheck = false;
		checkWifiSignal();
	}
}